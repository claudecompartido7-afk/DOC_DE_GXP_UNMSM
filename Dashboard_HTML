<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Gestion por Procesos - OGPL UNMSM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        corp: { bg: '#e8eef3', dark: '#0f1a2e', blue: '#3b82f6', teal: '#14b8a6', card: '#ffffff', textmain: '#1e293b', textmuted: '#64748b' }
                    },
                    fontFamily: { sans: ['Outfit', 'Inter', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        * { font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif; }
        body { background-color: #e8eef3; }

        /* ===== GLASS & CARDS ===== */
        .glass-card {
            background: linear-gradient(145deg, #ffffff, #f3f7fa);
            border-radius: 1.25rem;
            box-shadow: 10px 10px 20px rgba(15, 26, 46, 0.1), -10px -10px 20px rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 15px 15px 30px rgba(15, 26, 46, 0.15), -15px -15px 30px rgba(255, 255, 255, 1);
        }
        .dark-panel {
            background: linear-gradient(145deg, #162541, #0c1525);
            box-shadow: 12px 12px 24px rgba(10, 15, 25, 0.4), -8px -8px 16px rgba(40, 55, 80, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .btn-depth {
            background: linear-gradient(145deg, #ffffff, #e6e6e6);
            box-shadow: 5px 5px 10px rgba(15, 26, 46, 0.1), -5px -5px 10px rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.2s ease;
        }
        .btn-depth:hover {
            box-shadow: 2px 2px 5px rgba(15, 26, 46, 0.1), -2px -2px 5px rgba(255, 255, 255, 0.9);
            transform: translateY(2px);
        }
        .btn-depth-primary {
            background: linear-gradient(145deg, #101c31, #0d1729);
            box-shadow: 5px 5px 10px rgba(10, 15, 25, 0.3), -3px -3px 8px rgba(40, 55, 80, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }
        .btn-depth-primary:hover {
            box-shadow: 2px 2px 5px rgba(10, 15, 25, 0.3), -1px -1px 3px rgba(40, 55, 80, 0.2);
            transform: translateY(2px);
        }
        .mini-bar { height: 100%; background-color: #3b82f6; border-radius: 2px; opacity: 0.8; transition: all 0.3s ease; }
        .mini-bar:hover { opacity: 1; transform: scaleY(1.1); }
        .mini-bar-container { display: flex; align-items: flex-end; gap: 4px; height: 24px; margin-top: 12px; }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .custom-scrollbar { overflow-y: auto; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fadeIn 0.4s ease; }

        /* ===== ANALISIS ===== */
        :root{ --navy:#10233f; --navy2:#173355; --blue:#3f86ef; --blue2:#78aaf7; --bg:#eef3f8; --card:#ffffff; --text:#162742; --muted:#71829a; --green:#16a67f; --red:#ee6868; --line:#e8edf3; --shadow:0 8px 24px rgba(26,48,77,.09); }
        .switcher{margin:0 0 16px;display:flex;gap:8px;align-items:center}
        .tab-ana{border:0;background:#dce5ef;color:#60738a;font-weight:800;font-size:12px;padding:10px 18px;border-radius:12px;cursor:pointer;transition:all .2s}
        .tab-ana.active{background:var(--blue);color:#fff;box-shadow:0 6px 14px rgba(63,134,239,.24)}
        .panel-ana{display:none}.panel-ana.active{display:block; animation: fadeIn 0.3s ease;}
        .section-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
        @media(max-width:1100px){.section-grid{grid-template-columns:1fr}}
        .entity-card{background:var(--card);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}
        .entity-head{padding:12px 15px;background:linear-gradient(180deg,#f8fbff,#fff);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
        .entity-title{font-size:12px;font-weight:900;color:var(--text)}.entity-tag{font-size:10px;font-weight:800;padding:6px 10px;border-radius:10px;background:#53647a;color:#fff}
        .entity-body{padding:14px}
        .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:13px}
        .metric{border:1px solid var(--line);border-radius:11px;padding:10px 9px;min-width:0; transition: all 0.2s ease; cursor:pointer;}
        .metric .m-title{font-size:9px;font-weight:800;color:#60738a;line-height:1.2;min-height:24px}
        .metric .m-num{font-size:20px;color:#2f75ed;font-weight:900;margin-top:4px}
        .metric .m-den{font-size:9px;font-weight:700;color:#5d6f85}
        .metric .m-change{font-size:8px;color:var(--green);font-weight:800;margin-top:5px}
        .chart-box{border:1px solid var(--line);border-radius:11px;padding:10px 10px 8px}
        .chart-title{font-size:9px;font-weight:900;margin-bottom:8px;color:var(--text)}
        .bars{display:grid;gap:8px}
        .bar-row{display:grid;grid-template-columns:72px 1fr 30px;gap:7px;align-items:center;font-size:8px;color:var(--muted)}
        .track{height:8px;background:#edf1f5;border-radius:999px;overflow:hidden}
        .fill{height:100%;background:var(--blue);border-radius:999px}
        .fill.dark{background:#1a2b47}.fill.green{background:#22b89a}
        .bar-row strong{font-size:8px;text-align:right;color:var(--text)}
        .data-panel{margin-top:16px;background:var(--card);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}
        .data-toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,#f8fbff,#fff)}
        .data-toolbar .title{font-size:12px;font-weight:900;margin-right:auto;color:var(--text)}
        .select-wrap{position:relative}
        .select-wrap select{appearance:auto;border:1px solid #d8e1eb;border-radius:9px;background:#fff;padding:8px 10px;color:#536980;font-size:10px;font-weight:750;max-width:210px}
        .data-meta{padding:10px 16px;font-size:9px;color:#7f90a6;border-bottom:1px solid var(--line);display:flex;gap:14px;flex-wrap:wrap}
        .table-wrap{overflow:auto;max-height:460px}
        .data-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1280px;font-size:9px}
        .data-table th{position:sticky;top:0;z-index:3;background:#eff4f8;color:#38506a;text-align:left;padding:10px 9px;border-bottom:1px solid #dbe3eb;white-space:nowrap;font-size:8px;letter-spacing:.1px}
        .data-table td{padding:9px;border-bottom:1px solid #edf1f5;vertical-align:top;color:#41566d;line-height:1.3}
        .data-table tbody tr:nth-child(even){background:#fbfcfd}
        .data-table tbody tr:hover{background:#f1f7ff}
        .status-ok{font-weight:900;color:#118363}.cumplimiento{font-weight:900;color:#2f75ed}.criterios{font-weight:800;color:#4f6075;white-space:nowrap}.obs{min-width:230px}
        .data-footer{padding:10px 16px;font-size:9px;color:#7d8fa4;background:#fafcff}
        .rank-list{display:grid;gap:8px}
        .rank-row{display:grid;grid-template-columns:62px 1fr 40px;gap:8px;align-items:center;font-size:8px}
        .rank-row strong{text-align:right;font-size:8px}
        .rank-track{height:9px;background:#eff2f5;border-radius:999px;overflow:hidden}
        .rank-fill{height:100%;background:var(--blue2)}.rank-fill.dark{background:#16273f}.rank-fill.green{background:#23b89b}
        .anexo3-layout{display:grid;grid-template-columns:1.1fr 1.4fr;gap:16px}
        @media(max-width:1100px){.anexo3-layout{grid-template-columns:1fr}}
        .anexo3-card{background:var(--card);border-radius:18px;box-shadow:var(--shadow);padding:18px}
        .anexo3-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
        .big-metric{border:1px solid var(--line);border-radius:12px;padding:15px; transition: all 0.2s ease; cursor:pointer;}
        .big-metric h4{margin:0;font-size:10px;color:#64778e;font-weight:700}
        .big-metric .n{margin-top:8px;font-size:29px;color:#2f75ed;font-weight:900}
        .big-metric .den{font-size:9px;font-weight:750;color:#5d6f85}
        .big-metric .chg{margin-top:7px;font-size:9px;color:var(--green);font-weight:800}
        .status-filter{cursor:pointer;transition:all .18s ease;user-select:none}
        .status-filter:hover{transform:translateY(-1px);border-color:#9bbff6}
        .status-filter.active-status{background:#eaf3ff;border-color:#6fa3f2;box-shadow:inset 0 0 0 1px rgba(63,134,239,.14)}
        .status-filter.active-status .m-title,.status-filter.active-status .m-change{color:#2f75ed}
        .status-filter.inactive-status{opacity:.48}
        .status-filter.inactive-status:hover{opacity:.7}
        .big-metric.status-filter.active-status{background:#eaf3ff;border-color:#6fa3f2;box-shadow:inset 0 0 0 1px rgba(63,134,239,.14)}
        .big-metric.status-filter.active-status h4,.big-metric.status-filter.active-status .chg{color:#2f75ed}
        .big-metric.status-filter.inactive-status{opacity:.48}
        .big-metric.status-filter.inactive-status:hover{opacity:.7}
        .notice{font-size:9px;color:#7f90a6;margin-top:12px}

        /* ===== BASE DE DATOS ===== */
        .db-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
        .db-search-wrap { position: relative; flex: 1; min-width: 280px; max-width: 480px; }
        .db-search-wrap i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 13px; }
        .db-search-wrap input { width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #d8e1eb; border-radius: 12px; background: #fff; color: #334155; font-size: 12px; font-weight: 600; outline: none; transition: all 0.2s ease; box-shadow: 0 2px 8px rgba(26,48,77,.04); }
        .db-search-wrap input:focus { border-color: #3f86ef; box-shadow: 0 0 0 3px rgba(63,134,239,.12); }
        .db-search-wrap input::placeholder { color: #94a3b8; font-weight: 500; }
        .db-actions { display: flex; gap: 8px; align-items: center; }
        .db-btn { padding: 9px 16px; border-radius: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; border: 1px solid #d8e1eb; background: #fff; color: #536980; transition: all 0.18s ease; display: flex; align-items: center; gap: 6px; }
        .db-btn:hover { border-color: #9bbff6; background: #f8fbff; transform: translateY(-1px); }
        .db-btn.primary { background: linear-gradient(145deg, #3f86ef, #2563eb); color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(63,134,239,.28); }
        .db-btn.primary:hover { box-shadow: 0 6px 16px rgba(63,134,239,.36); transform: translateY(-1px); }
        .db-filters-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
        .db-filter-chip { padding: 7px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; cursor: pointer; border: 1px solid var(--line); background: #fff; color: #60738a; transition: all 0.18s ease; user-select: none; }
        .db-filter-chip:hover { border-color: #9bbff6; transform: translateY(-1px); }
        .db-filter-chip.active { background: linear-gradient(145deg, #3f86ef, #2563eb); color: #fff; border-color: transparent; box-shadow: 0 4px 10px rgba(63,134,239,.24); }
        .db-table-card { background: var(--card); border-radius: 18px; box-shadow: var(--shadow); overflow: hidden; }
        .db-table-card .data-toolbar { background: linear-gradient(180deg,#f8fbff,#fff); }
        .db-table-card .data-table { font-size: 11px; }
        .db-table-card .data-table th { font-size: 10px; padding: 12px 10px; background: #eff4f8; font-weight: 800; letter-spacing: 0.04em; }
        .db-table-card .data-table td { padding: 10px; font-size: 11px; font-weight: 500; }
        .db-pagination { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #fafcff; border-top: 1px solid var(--line); }
        .db-page-info { font-size: 11px; color: #7d8fa4; font-weight: 600; }
        .db-page-buttons { display: flex; gap: 4px; }
        .db-page-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #d8e1eb; background: #fff; color: #536980; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.15s ease; display: flex; align-items: center; justify-content: center; }
        .db-page-btn:hover:not(:disabled) { border-color: #3f86ef; color: #3f86ef; background: #f0f7ff; }
        .db-page-btn.active { background: linear-gradient(145deg, #3f86ef, #2563eb); color: #fff; border-color: transparent; box-shadow: 0 2px 8px rgba(63,134,239,.28); }
        .db-page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .db-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 800; letter-spacing: 0.02em; }
        .db-badge.ok { background: #dcfce7; color: #15803d; }
        .db-badge.warn { background: #fef3c7; color: #b45309; }
        .db-badge.danger { background: #fee2e2; color: #b91c1c; }
        .db-badge.info { background: #dbeafe; color: #1d4ed8; }
        .db-badge.gray { background: #f1f5f9; color: #475569; }
        .db-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
        @media(max-width:900px){.db-summary{grid-template-columns:repeat(2,1fr)}}
        .db-summary-card { background: var(--card); border-radius: 16px; box-shadow: var(--shadow); padding: 18px; display: flex; align-items: center; gap: 14px; transition: all 0.2s ease; }
        .db-summary-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(26,48,77,.12); }
        .db-summary-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .db-summary-info h4 { font-size: 11px; color: #71829a; font-weight: 700; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.04em; }
        .db-summary-info .val { font-size: 24px; font-weight: 900; color: #162742; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
        .db-empty { padding: 40px; text-align: center; color: #7f90a6; font-size: 13px; }

        /* ===== SIDEBAR ACTIVE STATE ===== */
        .nav-btn { position: relative; }
        .nav-btn.active { background: linear-gradient(145deg, #101c31, #0d1729); color: #fff; box-shadow: 5px 5px 10px rgba(10,15,25,0.3), -3px -3px 8px rgba(40,55,80,0.2); }
        .nav-btn.active::after { content: ''; position: absolute; right: -6px; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: #3b82f6; border-radius: 2px; }

        /* ===== VIEW TOGGLE ===== */
        .view-section { display: none; }
        .view-section.active { display: flex; animation: fadeIn 0.35s ease; }

        /* ===== EMPTY STATE ===== */
        .empty-state { padding: 40px; text-align: center; color: var(--muted); }
        .empty-state i { font-size: 32px; margin-bottom: 12px; opacity: 0.4; }
    </style>
<base target="_blank">
</head>
<body class="text-corp-textmain h-screen flex overflow-hidden selection:bg-corp-blue selection:text-white">

    <!-- SIDEBAR -->
    <aside class="w-20 bg-white/30 flex flex-col items-center py-8 gap-10 border-r border-white/60 z-10 backdrop-blur-sm shrink-0">
        <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-corp-dark text-2xl btn-depth">
            <i class="fa-solid fa-layer-group"></i>
        </div>
        <div class="flex flex-col gap-6 mt-4">
            <button id="nav-dashboard" class="nav-btn w-12 h-12 bg-white rounded-full flex items-center justify-center text-corp-textmuted hover:text-corp-blue transition btn-depth" title="Dashboard" onclick="switchTab('dashboard')">
                <i class="fa-solid fa-gauge-high"></i>
            </button>
            <button id="nav-database" class="nav-btn w-12 h-12 bg-white rounded-full flex items-center justify-center text-corp-textmuted hover:text-corp-blue transition btn-depth" title="Base de Datos" onclick="switchTab('database')">
                <i class="fa-solid fa-database"></i>
            </button>
            <button id="nav-analisis" class="nav-btn w-12 h-12 bg-white rounded-full flex items-center justify-center text-corp-textmuted hover:text-corp-blue transition btn-depth" title="Analisis" onclick="switchTab('analisis')">
                <i class="fa-solid fa-chart-line"></i>
            </button>
        </div>
        <div class="mt-auto flex flex-col gap-4">
             <button class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-corp-textmuted hover:text-corp-blue transition btn-depth"><i class="fa-solid fa-gear"></i></button>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="flex-1 flex flex-col h-full overflow-hidden relative">
        <header class="flex justify-between items-center px-8 pt-8 pb-6 shrink-0">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-white rounded-xl btn-depth"><i class="fa-solid fa-users text-2xl text-corp-dark"></i></div>
                <div>
                    <h1 class="text-3xl font-extrabold text-corp-dark tracking-tight">Gestion por Procesos <span class="font-light text-corp-textmuted">Panel de Control</span></h1>
                    <p class="text-corp-textmuted text-sm mt-1 font-medium">Oficina de Racionalizacion OGPL UNMSM | Fecha de Corte: 28/08/2026</p>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <div class="bg-white/50 p-1.5 rounded-full flex gap-1 btn-depth backdrop-blur-sm">
                    <button id="btn-tab-dashboard" onclick="switchTab('dashboard')" class="px-8 py-2.5 bg-corp-dark text-white rounded-full text-sm font-bold shadow-lg shadow-corp-dark/30 btn-depth-primary transition-all">Dashboard</button>
                    <button id="btn-tab-analisis" onclick="switchTab('analisis')" class="px-8 py-2.5 bg-white text-corp-textmuted rounded-full text-sm font-bold hover:text-corp-dark transition-all btn-depth">Analisis</button>
                    <button id="btn-tab-database" onclick="switchTab('database')" class="px-8 py-2.5 bg-white text-corp-textmuted rounded-full text-sm font-bold hover:text-corp-dark transition-all btn-depth">Base de datos</button>
                </div>
                <div class="flex gap-4">
                    <button class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-corp-textmuted hover:text-corp-dark transition btn-depth"><i class="fa-regular fa-bell text-lg"></i></button>
                    <button class="w-12 h-12 bg-corp-dark text-white rounded-full flex items-center justify-center btn-depth-primary"><i class="fa-solid fa-house text-lg"></i></button>
                </div>
            </div>
        </header>

        <div class="flex gap-8 flex-1 px-8 pb-8 min-h-0">
            <!-- FILTERS SIDEBAR -->
            <aside class="w-72 rounded-[2rem] p-6 text-white flex flex-col dark-panel z-10 sticky top-0 shrink-0 overflow-hidden">
                <div class="flex justify-between items-center mb-8 border-b border-white/10 pb-4">
                    <div class="flex items-center gap-3"><i class="fa-solid fa-filter text-xl text-blue-400"></i><span class="font-bold tracking-wide">Filtros</span></div>
                    <button class="text-white/50 hover:text-white transition" onclick="resetAllFilters()"><i class="fa-solid fa-rotate-right"></i></button>
                </div>
                <div class="mb-8 flex-1 overflow-y-auto pr-2 custom-scrollbar">
                    <div class="flex justify-between items-center mb-4 sticky top-0 bg-[#14223c] pt-2 pb-2 z-10 backdrop-blur-md">
                        <h3 class="text-xs font-bold text-white/60 uppercase tracking-widest">FACULTADES</h3>
                        <div class="flex gap-2 text-white/40"><i class="fa-solid fa-sort text-xs"></i></div>
                    </div>
                    <ul id="faculty-list" class="flex flex-col gap-2.5"></ul>
                </div>
                <div class="border-t border-white/10 pt-4">
                    <div class="text-xs text-white/40 mb-2">Resumen seleccion</div>
                    <div class="flex justify-between text-sm"><span class="text-white/70">Facultades:</span><span id="fac-count" class="font-bold">20</span></div>
                    <div class="flex justify-between text-sm mt-1"><span class="text-white/70">Procesos:</span><span id="proc-count" class="font-bold">16</span></div>
                </div>
            </aside>

            <!-- ===== VISTA 1: DASHBOARD ===== -->
            <div id="view-dashboard" class="view-section active flex-1 flex-col gap-6 overflow-y-auto pr-2 custom-scrollbar">
                <div class="grid grid-cols-4 gap-6">
                    <div class="glass-card p-6 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-2.5 h-full bg-corp-dark rounded-r-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <h3 class="text-sm font-bold text-corp-textmuted uppercase tracking-wider mb-2">% Avance Fase 1</h3>
