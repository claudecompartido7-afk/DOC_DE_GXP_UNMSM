    <style>
        /* Estilos Neumórficos y 3D */
        body { background-color: #e8eef3; }
        
        .glass-card {
            background: linear-gradient(145deg, #ffffff, #f3f7fa);
            border-radius: 1.25rem;
            /* Sombra 3D: Oscura abajo-derecha, clara arriba-izquierda */
            box-shadow: 10px 10px 20px rgba(15, 26, 46, 0.1), 
                        -10px -10px 20px rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
        }
        
        .glass-card:hover {
            transform: translateY(-5px);
            /* Sombra más profunda al hacer hover */
            box-shadow: 15px 15px 30px rgba(15, 26, 46, 0.15), 
                        -15px -15px 30px rgba(255, 255, 255, 1);
        }
        
        .dark-panel {
            background: linear-gradient(145deg, #162541, #0c1525); /* Gradiente para dar volumen */
            /* Sombra 3D invertida para panel oscuro */
            box-shadow: 12px 12px 24px rgba(10, 15, 25, 0.4), 
                        -8px -8px 16px rgba(40, 55, 80, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .btn-depth {
            background: linear-gradient(145deg, #ffffff, #e6e6e6);
            /* Efecto botón pill en relieve */
            box-shadow: 5px 5px 10px rgba(15, 26, 46, 0.1), 
                        -5px -5px 10px rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.2s ease;
        }
        
        .btn-depth:hover {
            box-shadow: 2px 2px 5px rgba(15, 26, 46, 0.1), 
                        -2px -2px 5px rgba(255, 255, 255, 0.9);
            transform: translateY(2px);
        }

        /* Estilo para los botones activos o primarios (azules) */
        .btn-depth-primary {
            background: linear-gradient(145deg, #101c31, #0d1729);
            box-shadow: 5px 5px 10px rgba(10, 15, 25, 0.3), 
                        -3px -3px 8px rgba(40, 55, 80, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }
        
        .btn-depth-primary:hover {
            box-shadow: 2px 2px 5px rgba(10, 15, 25, 0.3), 
                        -1px -1px 3px rgba(40, 55, 80, 0.2);
            transform: translateY(2px);
        }

        .mini-bar {
            height: 100%;
            background-color: #3b82f6;
            border-radius: 2px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }
        .mini-bar:hover {
            opacity: 1;
            transform: scaleY(1.1);
        }
        .mini-bar-container {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 24px;
            margin-top: 12px;
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    </style>
</head>

