function exportDbToCSV() {
    const data = getDbFilteredData();
    const headers = ['#','Entidad','Anexo','Facultad','Proceso','Codigo','Nombre','Tipo','Estado','Cumplimiento','Criterios','Observaciones'];
    const rows = data.map((d,i) => [i+1,d.entity,d.anexo,d.faculty,d.process,d.code,d.name,d.type,d.status,d.compliance,d.criteria,d.observations]);
    const csv = [headers,...rows].map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'base_datos_unmsm.csv'; a.click();
    URL.revokeObjectURL(url);
}

