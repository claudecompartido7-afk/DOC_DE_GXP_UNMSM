// BASE DE DATOS
// ============================================================
let dbPage = 1;
const dbPageSize = 12;
let dbEntityFilter = 'all';
let dbStatusFilter = 'all';

function populateDbFilters() {
    const facs = [...new Set(allData.map(d => d.faculty))].sort();
    const procs = [...new Set(allData.map(d => d.process))].sort();
    const f = document.getElementById('dbFilterFaculty');
    const p = document.getElementById('dbFilterProcess');
    facs.forEach(fc => { const o = document.createElement('option'); o.value = fc; o.textContent = fc; f.appendChild(o); });
    procs.forEach(pr => { const o = document.createElement('option'); o.value = pr; o.textContent = pr; p.appendChild(o); });
}

function getDbFilteredData() {
    const search = document.getElementById('dbSearchInput').value.toLowerCase();
    const fac = document.getElementById('dbFilterFaculty').value;
    const proc = document.getElementById('dbFilterProcess').value;
    const anexo = document.getElementById('dbFilterAnexo').value;

    return allData.filter(d => {
        if (dbEntityFilter !== 'all' && d.entity !== dbEntityFilter) return false;
        if (dbStatusFilter !== 'all' && d.status !== dbStatusFilter) return false;
        if (fac && d.faculty !== fac) return false;
        if (proc && d.process !== proc) return false;
        if (anexo && d.anexo !== anexo) return false;
        if (search) {
            const hay = `${d.faculty} ${d.process} ${d.code} ${d.name} ${d.type} ${d.status} ${d.observations}`.toLowerCase();
            if (!hay.includes(search)) return false;
        }
        return true;
    });
}

function getDbBadgeClass(status) {
    if (status === 'CONFORME' || status === 'COMPLETA') return 'ok';
    if (status === 'OBSERVADO' || status === 'INCOMPLETA') return 'warn';
    if (status === 'SIN REGISTRO' || status === 'SIN PRODUCTO') return 'danger';
    return 'gray';
}

function renderDatabase() {
    const data = getDbFilteredData();
    const total = data.length;
    const totalPages = Math.max(1, Math.ceil(total / dbPageSize));
    if (dbPage > totalPages) dbPage = totalPages;
    if (dbPage < 1) dbPage = 1;
    const start = (dbPage - 1) * dbPageSize;
    const pageData = data.slice(start, start + dbPageSize);

    // Summary
    const ok = allData.filter(d => d.status === 'CONFORME' || d.status === 'COMPLETA').length;
    const warn = allData.filter(d => d.status === 'OBSERVADO' || d.status === 'INCOMPLETA').length;
    const danger = allData.filter(d => d.status === 'SIN REGISTRO' || d.status === 'SIN PRODUCTO').length;
    document.getElementById('dbTotalCount').textContent = allData.length;
    document.getElementById('dbOkCount').textContent = ok;
    document.getElementById('dbWarnCount').textContent = warn;
    document.getElementById('dbDangerCount').textContent = danger;

    // Meta
    document.getElementById('dbShowingCount').textContent = total;
    document.getElementById('dbTotalMeta').textContent = allData.length;
    document.getElementById('dbPageMeta').textContent = dbPage;
    document.getElementById('dbTotalPages').textContent = totalPages;
    document.getElementById('dbPageInfo').textContent = total === 0 ? 'No hay registros para mostrar' : `Mostrando ${start+1}-${Math.min(start+dbPageSize,total)} de ${total} registros`;

    const entityLabel = dbEntityFilter === 'all' ? 'Todos' : dbEntityFilter + 's';
    const statusLabel = dbStatusFilter === 'all' ? '' : ' · ' + dbStatusFilter;
    document.getElementById('dbTableTitle').textContent = `Registros consolidados · ${entityLabel}${statusLabel}`;

    // Rows
    const tbody = document.getElementById('dbRows');
    if (pageData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="12"><div class="db-empty"><i class="fa-solid fa-inbox" style="font-size:32px;margin-bottom:12px;opacity:.4;display:block;"></i>No se encontraron registros con los filtros aplicados.</div></td></tr>`;
    } else {
        tbody.innerHTML = pageData.map((d, i) => `
            <tr><td>${start+i+1}</td><td>${d.entity}</td><td>${d.anexo}</td><td>${d.faculty}</td><td>${d.process}</td>
            <td><code style="font-family:monospace;font-size:11px;color:#71829a;">${d.code}</code></td>
            <td>${d.name}</td><td>${d.type}</td>
            <td><span class="db-badge ${getDbBadgeClass(d.status)}">${d.status}</span></td>
            <td style="font-variant-numeric:tabular-nums;font-weight:700;">${d.compliance}</td>
            <td>${d.criteria}</td><td style="max-width:280px;">${d.observations}</td></tr>
        `).join('');
    }

    // Pagination
    const pg = document.getElementById('dbPageButtons');
    let html = `<button class="db-page-btn" onclick="goDbPage(${dbPage-1})" ${dbPage===1?'disabled':''}><i class="fa-solid fa-chevron-left" style="font-size:10px;"></i></button>`;
    for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= dbPage - 1 && i <= dbPage + 1)) {
            html += `<button class="db-page-btn ${i===dbPage?'active':''}" onclick="goDbPage(${i})">${i}</button>`;
        } else if (i === dbPage - 2 || i === dbPage + 2) {
            html += `<span style="padding:0 4px;color:#94a3b8;font-size:12px;">...</span>`;
        }
    }
    html += `<button class="db-page-btn" onclick="goDbPage(${dbPage+1})" ${dbPage===totalPages?'disabled':''}><i class="fa-solid fa-chevron-right" style="font-size:10px;"></i></button>`;
    pg.innerHTML = html;
}

function goDbPage(p) { dbPage = p; renderDatabase(); }

function setDbEntityFilter(val) {
    dbEntityFilter = val; dbPage = 1;
    document.querySelectorAll('.db-filter-chip[data-filter]').forEach(b => b.classList.toggle('active', b.dataset.filter === val));
    renderDatabase();
}

function setDbStatusFilter(val) {
    dbStatusFilter = val; dbPage = 1;
    document.querySelectorAll('.db-filter-chip[data-status]').forEach(b => b.classList.toggle('active', b.dataset.status === val));
    renderDatabase();
}

function resetDbFilters() {
    document.getElementById('dbSearchInput').value = '';
